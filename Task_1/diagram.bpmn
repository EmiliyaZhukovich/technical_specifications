    <bpmn:messageFlow id="Flow_1rrnvd2" sourceRef="Activity_1uzo5g7" targetRef="Event_1xkp1h4" />
    <bpmn:messageFlow id="Flow_1v35g2c" sourceRef="Event_0xuqb4g" targetRef="Event_145f6hb" />
    <bpmn:textAnnotation id="TextAnnotation_1ulfzmr">
      <bpmn:text>На почте/ экран кабинета</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_0bdi42w">
      <bpmn:text>Нет веток для ошибок (например, что если доставка задерживается или невозможна)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_0gq7n8j">
      <bpmn:text>Как именно пользователь получает этот номер (по почте, по телефону, в системе?)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_0dddg26">
      <bpmn:text>Не описан механизм уведомления пользователя о номере обращения и отслеживания статуса</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_02zs8u9">
      <bpmn:text>Не указано, как именно происходит вызов (заявка в системе, почта, телефон, устно). Нет информации о том, подтверждает ли логистика приём задачи или работает автоматически.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_16epva1">
      <bpmn:text>Недостаток: не описано, как именно пользователь может это сделать (ссылка в почте, в системе №1, опрос по телефону). Неясно, влияет ли это на процесс или идёт параллельно.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_1a2qe65" associationDirection="None" sourceRef="Activity_0g4ljsw" targetRef="TextAnnotation_1ulfzmr" />
